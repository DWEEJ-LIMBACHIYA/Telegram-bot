# Copy to .env (never commit .env!) or enter these in Hostinger Docker Manager.

# Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Telegram user IDs allowed to use the bot, comma-separated. Empty = anyone.
# Get yours from @userinfobot.
ALLOWED_USER_IDS=

# Timezone for new users (they can change it with /timezone)
DEFAULT_TIMEZONE=America/Toronto

# When the evening "anything for tomorrow?" message is sent (each user can change it with /nightly)
NIGHTLY_TIME=21:00

# Event reminders: minutes before the start
REMINDER_MINUTES=30

# Where the SQLite database lives (the Docker image sets this to /app/data/bot.db)
DB_PATH=data/bot.db
